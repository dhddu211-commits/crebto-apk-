rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVES ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email == 'dhddu211@gmail.com' &&
             request.auth.token.email_verified == true;
    }
    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }
    function isOptionalString(data, field, maxLen) {
      return !('' + field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    // --- VALIDATION BLUEPRINTS ---
    function isValidPublicUser(data) {
      return data.keys().hasAll([
               'userId', 'displayName', 'username', 'avatarMediaType', 'bannerMediaType',
               'followersCount', 'followingCount', 'likesCount', 'isBanned', 'isVerified',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'displayName', 'username', 'bio', 'avatarUrl', 'avatarMediaType',
               'bannerUrl', 'bannerMediaType', 'followersCount', 'followingCount', 'likesCount',
               'isBanned', 'banReason', 'isVerified', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && isValidId(data.userId) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 40 &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 300)) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
             data.avatarMediaType in ['image', 'video'] &&
             (!('bannerUrl' in data) || data.bannerUrl == null || (data.bannerUrl is string && data.bannerUrl.size() <= 1000)) &&
             data.bannerMediaType in ['image', 'video'] &&
             data.followersCount is int && data.followersCount >= 0 &&
             data.followingCount is int && data.followingCount >= 0 &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.isBanned is bool &&
             (!('banReason' in data) || data.banReason == null || (data.banReason is string && data.banReason.size() <= 300)) &&
             data.isVerified is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPrivateUser(data) {
      return data.keys().hasAll(['userId', 'email', 'preferredLanguage', 'isBanned', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'email', 'phoneNumber', 'preferredLanguage', 'isBanned', 'createdAt', 'updatedAt']) &&
             data.userId is string && isValidId(data.userId) &&
             data.email is string && data.email.size() <= 200 &&
             (!('phoneNumber' in data) || data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 40)) &&
             data.preferredLanguage in ['ar', 'en'] &&
             data.isBanned is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidVideo(data) {
      return data.keys().hasAll([
               'authorId', 'authorName', 'authorAvatarType', 'videoType', 'title',
               'category', 'mediaUrl', 'durationSeconds', 'likesCount', 'commentsCount',
               'repostsCount', 'favoritesCount', 'viewsCount', 'viralBoostScore', 'isBanned',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'authorId', 'authorName', 'authorAvatarUrl', 'authorAvatarType', 'videoType',
               'title', 'description', 'tags', 'category', 'mediaUrl', 'thumbnailUrl',
               'durationSeconds', 'likesCount', 'commentsCount', 'repostsCount',
               'favoritesCount', 'viewsCount', 'viralBoostScore', 'isBanned', 'banReason',
               'createdAt', 'updatedAt'
             ]) &&
             data.authorId is string && isValidId(data.authorId) &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             (!('authorAvatarUrl' in data) || data.authorAvatarUrl == null || (data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 1000)) &&
             data.authorAvatarType in ['image', 'video'] &&
             data.videoType in ['reel', 'long', 'photo'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 1000)) &&
             (!('tags' in data) || data.tags == null || (data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string))) &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
             data.mediaUrl is string && data.mediaUrl.size() >= 1 && data.mediaUrl.size() <= 1500 &&
             (!('thumbnailUrl' in data) || data.thumbnailUrl == null || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1500)) &&
             data.durationSeconds is int && data.durationSeconds >= 0 &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.commentsCount is int && data.commentsCount >= 0 &&
             data.repostsCount is int && data.repostsCount >= 0 &&
             data.favoritesCount is int && data.favoritesCount >= 0 &&
             data.viewsCount is int && data.viewsCount >= 0 &&
             data.viralBoostScore is int && data.viralBoostScore >= 0 &&
             data.isBanned is bool &&
             (!('banReason' in data) || data.banReason == null || (data.banReason is string && data.banReason.size() <= 300)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidComment(data, videoId) {
      return data.keys().hasAll(['videoId', 'authorId', 'authorName', 'text', 'createdAt']) &&
             data.keys().hasOnly(['videoId', 'authorId', 'authorName', 'authorAvatarUrl', 'text', 'createdAt']) &&
             data.videoId == videoId &&
             data.authorId is string && isValidId(data.authorId) &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             (!('authorAvatarUrl' in data) || data.authorAvatarUrl == null || (data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 1000)) &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidStory(data) {
      return data.keys().hasAll([
               'authorId', 'authorName', 'authorAvatarType', 'mediaUrl', 'mediaType',
               'viewsCount', 'isBanned', 'expiresAtMillis', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'authorId', 'authorName', 'authorAvatarUrl', 'authorAvatarType', 'mediaUrl',
               'mediaType', 'caption', 'viewsCount', 'isBanned', 'banReason', 'expiresAtMillis',
               'createdAt', 'updatedAt'
             ]) &&
             data.authorId is string && isValidId(data.authorId) &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             (!('authorAvatarUrl' in data) || data.authorAvatarUrl == null || (data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 1000)) &&
             data.authorAvatarType in ['image', 'video'] &&
             data.mediaUrl is string && data.mediaUrl.size() >= 1 && data.mediaUrl.size() <= 1500 &&
             data.mediaType in ['image', 'video'] &&
             (!('caption' in data) || data.caption == null || (data.caption is string && data.caption.size() <= 300)) &&
             data.viewsCount is int && data.viewsCount >= 0 &&
             data.isBanned is bool &&
             (!('banReason' in data) || data.banReason == null || (data.banReason is string && data.banReason.size() <= 300)) &&
             data.expiresAtMillis is int && data.expiresAtMillis > 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidInteraction(data) {
      return data.keys().hasAll(['userId', 'videoId', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'videoId', 'createdAt']) &&
             data.userId is string && isValidId(data.userId) &&
             data.videoId is string && isValidId(data.videoId) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidRepost(data) {
      return data.keys().hasAll(['userId', 'videoId', 'isPublic', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'videoId', 'isPublic', 'createdAt']) &&
             data.userId is string && isValidId(data.userId) &&
             data.videoId is string && isValidId(data.videoId) &&
             data.isPublic is bool &&
             isValidTimestamp(data.createdAt);
    }

    function isValidFollow(data) {
      return data.keys().hasAll(['followerId', 'followingId', 'createdAt']) &&
             data.keys().hasOnly(['followerId', 'followingId', 'createdAt']) &&
             data.followerId is string && isValidId(data.followerId) &&
             data.followingId is string && isValidId(data.followingId) &&
             data.followerId != data.followingId &&
             isValidTimestamp(data.createdAt);
    }

    function isValidChat(data) {
      return data.keys().hasAll([
               'participantIds', 'participant1Name', 'participant2Name',
               'lastMessage', 'lastSenderId', 'isBanned', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'participantIds', 'participant1Name', 'participant2Name',
               'lastMessage', 'lastSenderId', 'isBanned', 'banReason', 'createdAt', 'updatedAt'
             ]) &&
             data.participantIds is list && data.participantIds.size() == 2 &&
             data.participantIds[0] is string && data.participantIds[1] is string &&
             data.participant1Name is string && data.participant1Name.size() >= 1 && data.participant1Name.size() <= 80 &&
             data.participant2Name is string && data.participant2Name.size() >= 1 && data.participant2Name.size() <= 80 &&
             data.lastMessage is string && data.lastMessage.size() <= 500 &&
             data.lastSenderId is string && data.lastSenderId.size() <= 128 &&
             data.isBanned is bool &&
             (!('banReason' in data) || data.banReason == null || (data.banReason is string && data.banReason.size() <= 300)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidChatMessage(data, chatId) {
      return data.keys().hasAll(['chatId', 'participantIds', 'senderId', 'senderName', 'text', 'createdAt']) &&
             data.keys().hasOnly(['chatId', 'participantIds', 'senderId', 'senderName', 'text', 'createdAt']) &&
             data.chatId == chatId &&
             data.participantIds is list && data.participantIds.size() == 2 &&
             data.participantIds[0] is string && data.participantIds[1] is string &&
             data.senderId is string && isValidId(data.senderId) &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidAdminAlert(data) {
      return data.keys().hasAll(['targetUserId', 'title', 'message', 'severity', 'sentByEmail', 'isRead', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['targetUserId', 'title', 'message', 'severity', 'sentByEmail', 'isRead', 'createdAt', 'updatedAt']) &&
             data.targetUserId is string && isValidId(data.targetUserId) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
             data.severity in ['warning', 'critical', 'ban_notice'] &&
             data.sentByEmail is string && data.sentByEmail.size() >= 3 && data.sentByEmail.size() <= 200 &&
             data.isRead is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- COLLECTION RULES ---

    // 1. Public Creator Profiles (no PII)
    match /users_public/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && (resource.data.isBanned == false || resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidPublicUser(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().isBanned == false &&
                       incoming().isVerified == false &&
                       incoming().followersCount == 0 &&
                       incoming().followingCount == 0 &&
                       incoming().likesCount == 0;

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidPublicUser(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (request.auth.uid == userId &&
                          existing().isBanned == false &&
                          incoming().isBanned == existing().isBanned &&
                          incoming().isVerified == existing().isVerified &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'displayName', 'username', 'bio', 'avatarUrl', 'avatarMediaType',
                            'bannerUrl', 'bannerMediaType', 'updatedAt'
                          ])) ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt']) &&
                          (incoming().followersCount == existing().followersCount + 1 ||
                           incoming().followersCount == existing().followersCount - 1)) ||
                         (request.auth.uid == userId &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['followingCount', 'updatedAt']) &&
                          (incoming().followingCount == existing().followingCount + 1 ||
                           incoming().followingCount == existing().followingCount - 1)) ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
                          (incoming().likesCount == existing().likesCount + 1 ||
                           incoming().likesCount == existing().likesCount - 1))
                       );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // 2. Private User PII (strictly owner or admin)
    match /users_private/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidPrivateUser(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().isBanned == false;

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidPrivateUser(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (request.auth.uid == userId &&
                          incoming().isBanned == existing().isBanned &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phoneNumber', 'preferredLanguage', 'updatedAt']))
                       );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // 3. Videos & Reels
    match /videos/{videoId} {
      allow get: if isSignedIn() && isValidId(videoId) && (resource.data.isBanned == false || resource.data.authorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.isBanned == false || resource.data.authorId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(videoId) &&
                       isValidVideo(incoming()) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().isBanned == false &&
                       incoming().likesCount == 0 &&
                       incoming().commentsCount == 0 &&
                       incoming().repostsCount == 0 &&
                       incoming().favoritesCount == 0 &&
                       incoming().viewsCount == 0;

      allow update: if isSignedIn() &&
                       isValidId(videoId) &&
                       isValidVideo(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (existing().authorId == request.auth.uid &&
                          existing().isBanned == false &&
                          incoming().isBanned == existing().isBanned &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'tags', 'category', 'updatedAt'])) ||
                         (existing().isBanned == false &&
                          incoming().isBanned == false &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'likesCount', 'commentsCount', 'repostsCount', 'favoritesCount',
                            'viewsCount', 'viralBoostScore', 'updatedAt'
                          ]))
                       );

      allow delete: if isSignedIn() && isValidId(videoId) && (existing().authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(videoId) && isValidId(commentId) && resource.data.videoId == videoId;
        allow list: if isSignedIn() && isValidId(videoId) && resource.data.videoId == videoId;

        allow create: if isSignedIn() &&
                         isValidId(videoId) &&
                         isValidId(commentId) &&
                         isValidComment(incoming(), videoId) &&
                         incoming().authorId == request.auth.uid &&
                         exists(/databases/$(database)/documents/videos/$(videoId)) &&
                         get(/databases/$(database)/documents/videos/$(videoId)).data.isBanned == false;

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(commentId) && (existing().authorId == request.auth.uid || isAdmin());
      }
    }

    // 4. Stories (24h)
    match /stories/{storyId} {
      allow get: if isSignedIn() && isValidId(storyId) && (resource.data.isBanned == false || resource.data.authorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.isBanned == false || resource.data.authorId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(storyId) &&
                       isValidStory(incoming()) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().isBanned == false &&
                       incoming().viewsCount == 0;

      allow update: if isSignedIn() &&
                       isValidId(storyId) &&
                       isValidStory(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (existing().isBanned == false &&
                          incoming().isBanned == false &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'updatedAt']) &&
                          incoming().viewsCount == existing().viewsCount + 1)
                       );

      allow delete: if isSignedIn() && isValidId(storyId) && (existing().authorId == request.auth.uid || isAdmin());
    }

    // 5. Likes & Favorites (strictly owner-isolated)
    match /likes/{likeId} {
      allow get: if isSignedIn() && isValidId(likeId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(likeId) && isValidInteraction(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       exists(/databases/$(database)/documents/videos/$(incoming().videoId));
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(likeId) && existing().userId == request.auth.uid;
    }

    match /favorites/{favoriteId} {
      allow get: if isSignedIn() && isValidId(favoriteId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(favoriteId) && isValidInteraction(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       exists(/databases/$(database)/documents/videos/$(incoming().videoId));
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(favoriteId) && existing().userId == request.auth.uid;
    }

    // 6. Reposts (public on profiles)
    match /reposts/{repostId} {
      allow get: if isSignedIn() && isValidId(repostId) && (resource.data.userId == request.auth.uid || resource.data.isPublic == true);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isPublic == true);
      allow create: if isSignedIn() && isValidId(repostId) && isValidRepost(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       exists(/databases/$(database)/documents/videos/$(incoming().videoId));
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(repostId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // 7. Follows
    match /follows/{followId} {
      allow get: if isSignedIn() && isValidId(followId) && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(followId) && isValidFollow(incoming()) && incoming().followerId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(followId) && existing().followerId == request.auth.uid;
    }

    // 8. Chats & Messages (Participants + Admin oversight & ban lock)
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(chatId) &&
                       isValidChat(incoming()) &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().isBanned == false;

      allow update: if isSignedIn() &&
                       isValidId(chatId) &&
                       isValidChat(incoming()) &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (request.auth.uid in existing().participantIds &&
                          existing().isBanned == false &&
                          incoming().isBanned == false &&
                          incoming().participantIds == existing().participantIds &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastSenderId', 'updatedAt']))
                       );

      allow delete: if isAdmin() && isValidId(chatId);

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(chatId) && isValidId(messageId) && (request.auth.uid in resource.data.participantIds || isAdmin());
        allow list: if isSignedIn() && isValidId(chatId) && (request.auth.uid in resource.data.participantIds || isAdmin());

        allow create: if isSignedIn() &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         isValidChatMessage(incoming(), chatId) &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
                         get(/databases/$(database)/documents/chats/$(chatId)).data.isBanned == false;

        allow update: if false;
        allow delete: if isAdmin() && isValidId(messageId);
      }
    }

    // 9. Admin Direct Alerts to Violators
    match /admin_alerts/{alertId} {
      allow get: if isSignedIn() && isValidId(alertId) && (resource.data.targetUserId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.targetUserId == request.auth.uid || isAdmin());

      allow create: if isAdmin() && isValidId(alertId) && isValidAdminAlert(incoming());

      allow update: if isSignedIn() &&
                       isValidId(alertId) &&
                       isValidAdminAlert(incoming()) &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (existing().targetUserId == request.auth.uid &&
                          incoming().targetUserId == existing().targetUserId &&
                          incoming().title == existing().title &&
                          incoming().message == existing().message &&
                          incoming().severity == existing().severity &&
                          incoming().sentByEmail == existing().sentByEmail &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt']))
                       );

      allow delete: if isAdmin() && isValidId(alertId);
    }
  }
}
